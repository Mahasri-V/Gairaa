POSTGRES_USER=airflow
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=airflow

# Keep the password here in sync with POSTGRES_PASSWORD.
# Percent-encode reserved URL characters in the password.
AIRFLOW_DB_CONN=postgresql+psycopg2://airflow:replace_with_a_strong_password@postgres:5432/airflow

# Replace both values with newly generated secrets before starting Airflow.
AIRFLOW_FERNET_KEY=replace_with_a_generated_fernet_key
AIRFLOW_JWT_SECRET=replace_with_a_long_random_secret
